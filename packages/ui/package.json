{
  "name": "@phialon/ui",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "nx": {
    "targets": {
      "components:add": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx ./scripts/components-add.ts",
          "cwd": "packages/ui",
          "forwardAllArgs": true
        }
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  }
}
